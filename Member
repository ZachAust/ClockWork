import java.util.ArrayList;
public class Member {
	private String name;
	private int numOfHours;
	private ArrayList<String> skills;
	public Member(String name, int numOfHours, ArrayList<String> skills)
	{
		this.name = name;
		this.numOfHours = numOfHours;
		this.skills = skills;
	}
	public void addHour(int hourAmount)
	{
		numOfHours += hourAmount;
	}
	public String getName()
	{
		return name;
	}
	public int getNumOfHours()
	{
		return numOfHours;
	}
	public void addSkill(String skill)
	{
		skills.add(skill);
	}
	
	public void removeSkill(String skill)
	{
		if(skills.indexOf(skill) == -1)
		{
			System.out.println("Skill was not found.");
		}
		else
		{
			skills.remove(skills.indexOf(skill));
			System.out.println("Skill " + skill + " was removed.");
		}
	}
	public int skillAmount()
	{
		return skills.size();
	}
	public void subtractHours(int hourAmount)
	{
		numOfHours -= hourAmount;
	}
	public ArrayList<String> getSkills()
	{
		return skills;
	}
	@Override
	public String toString()
	{
		return "Name: " + name + "\nSkills: " + skills;
	}
	public boolean findSkill(String skillAsked)
	{
		for(String skill : skills)
		{
			if(skill.equals(skillAsked))
			{
				return true;
			}
		}
		return false;
	}
}
